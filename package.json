{
  "name": "3d-boat-physics-simulator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=low",
    "validate": "npm run lint && npm run typecheck && npm run build && npm run audit",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "9.6.1",
    "lucide-react": "^0.553.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "simplex-noise": "^4.0.3",
    "three": "0.182.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.2.12",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.182.0",
    "autoprefixer": "^10.4.21",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "postcss": "8.5.22",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp",
    "@babel/core": "7.29.6",
    "js-yaml": "4.3.0",
    "tar": "7.5.21",
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "5.0.8"
    },
    "minimatch": "10.2.6"
  }
}
